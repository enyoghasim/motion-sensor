# Backend Local Environment Variables
# Copy this file to .env and adjust if needed

# --- PostgreSQL ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/motion_sensor

# --- MQTT (Mosquitto) ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# --- Redis (Celery broker) ---
REDIS_URL=redis://localhost:6379/0

# --- Resend (email) ---
# Get a key at https://resend.com/api-keys. Required for emails to actually send.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Motion Sensor <onboarding@resend.dev>
