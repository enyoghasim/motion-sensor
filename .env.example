# Copy this file to .env and adjust values as needed.
# `docker compose` loads .env automatically — no extra config required.

# --- PostgreSQL ---
POSTGRES_DB=motion_sensor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Port exposed on your machine (container always listens on 5432 internally).
POSTGRES_HOST_PORT=5432

# --- MQTT (Mosquitto) ---
# Hostname the backend uses to reach the broker over the Docker network.
MQTT_BROKER_HOST=mosquitto
# Port the backend uses internally — must match the `listener` port in mosquitto.conf.
MQTT_BROKER_PORT=1883
# Ports exposed on your machine for the MQTT/WebSocket listeners.
MQTT_HOST_PORT=1883
MQTT_WS_HOST_PORT=9001

# --- Backend ---
# Port exposed on your machine (container always listens on 8080 internally).
BACKEND_HOST_PORT=8080
